rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function sameSchool(schoolId) { return signedIn() && myUser().schoolId == schoolId; }
    function schoolOwner(schoolId) { return sameSchool(schoolId) && myUser().role == 'school'; }
    function chatMember(chatId) {
      return signedIn() && exists(/databases/$(database)/documents/chats/$(chatId))
        && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members
        && sameSchool(get(/databases/$(database)/documents/chats/$(chatId)).data.schoolId);
    }
    function classMember(classId) {
      return signedIn() && exists(/databases/$(database)/documents/classes/$(classId))
        && request.auth.uid in get(/databases/$(database)/documents/classes/$(classId)).data.members
        && sameSchool(get(/databases/$(database)/documents/classes/$(classId)).data.schoolId);
    }

    match /schools/{schoolId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.code == schoolId && request.resource.data.name is string;
      allow update: if signedIn() && resource.data.ownerId == request.auth.uid;
      allow delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (resource.data.schoolId == myUser().schoolId || request.auth.uid == userId);
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string && request.resource.data.name.size() >= 2
        && (request.resource.data.role == 'school' && request.resource.data.schoolId == ''
          || request.resource.data.role == 'student' && exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)));
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.name is string && request.resource.data.name.size() >= 2
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','className','bio','photoData','updatedAt','online','lastSeen','schoolId'])
        && (request.resource.data.schoolId == resource.data.schoolId
          || (resource.data.role == 'school' && resource.data.schoolId == ''
            && exists(/databases/$(database)/documents/schools/$(request.resource.data.schoolId))
            && get(/databases/$(database)/documents/schools/$(request.resource.data.schoolId)).data.ownerId == userId));
      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members && sameSchool(resource.data.schoolId);
      allow create: if signedIn() && request.resource.data.type == 'direct'
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members && request.resource.data.schoolId == myUser().schoolId
        && get(/databases/$(database)/documents/users/$(request.resource.data.members[0])).data.schoolId == myUser().schoolId
        && get(/databases/$(database)/documents/users/$(request.resource.data.members[1])).data.schoolId == myUser().schoolId
        && request.resource.data.memberNames is map;
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && sameSchool(resource.data.schoolId) && request.resource.data.members == resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt']);
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if chatMember(chatId);
        allow create: if chatMember(chatId) && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000 && request.resource.data.senderName is string;
        allow update, delete: if false;
      }
    }

    match /classes/{classId} {
      allow read: if signedIn() && sameSchool(resource.data.schoolId);
      allow create: if signedIn() && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.schoolId == myUser().schoolId && request.resource.data.members.size() == 1
        && request.auth.uid in request.resource.data.members && request.resource.data.name is string;
      allow update: if signedIn() && sameSchool(resource.data.schoolId)
        && ((request.auth.uid in resource.data.members && request.resource.data.members == resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessage','updatedAt']))
          || (!(request.auth.uid in resource.data.members) && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members','updatedAt'])));
      allow delete: if signedIn() && resource.data.creatorId == request.auth.uid;
      match /messages/{messageId} {
        allow read: if classMember(classId);
        allow create: if classMember(classId) && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000 && request.resource.data.senderName is string;
        allow update, delete: if false;
      }
    }

    match /posts/{postId} {
      allow read: if signedIn() && sameSchool(resource.data.schoolId);
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid
        && request.resource.data.schoolId == myUser().schoolId && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1500;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid && sameSchool(resource.data.schoolId);
      match /comments/{commentId} {
        allow read: if signedIn() && sameSchool(get(/databases/$(database)/documents/posts/$(postId)).data.schoolId);
        allow create: if signedIn() && sameSchool(get(/databases/$(database)/documents/posts/$(postId)).data.schoolId)
          && request.resource.data.authorId == request.auth.uid && request.resource.data.text is string
          && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 500;
        allow update, delete: if false;
      }
    }

    match /news/{itemId} {
      allow read: if signedIn() && sameSchool(resource.data.schoolId);
      allow create: if signedIn() && schoolOwner(request.resource.data.schoolId)
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && schoolOwner(resource.data.schoolId);
    }
    match /lessons/{itemId} {
      allow read: if signedIn() && sameSchool(resource.data.schoolId);
      allow create: if signedIn() && schoolOwner(request.resource.data.schoolId)
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && schoolOwner(resource.data.schoolId);
    }
    match /staff/{itemId} {
      allow read: if signedIn() && sameSchool(resource.data.schoolId);
      allow create: if signedIn() && schoolOwner(request.resource.data.schoolId);
      allow update, delete: if signedIn() && schoolOwner(resource.data.schoolId);
    }
  }
}
